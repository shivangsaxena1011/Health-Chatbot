# Environment Variables for Swasth AI 2.0

# Database Connection (PostgreSQL with pgvector)
# Example: postgresql://postgres:postgres@localhost:5432/swasth_ai_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swasth_ai_db?schema=public"

# Google Gemini API Key (Server-Side ONLY - Never expose to client)
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT Secret for Secure HttpOnly Session Cookies
AUTH_SECRET="swasth_super_secure_jwt_secret_change_in_production_min_32_chars"

# Node Environment
NODE_ENV="development"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Country Emergency Number Configuration (e.g. IN=112, US=911, UK=999)
DEFAULT_EMERGENCY_COUNTRY="IN"
